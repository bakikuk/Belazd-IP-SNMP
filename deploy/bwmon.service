# Same as guides/bwmon.service — see guides/systemd-daemon.md
[Unit]
Description=BWMON per-IP bandwidth SNMP agent
Documentation=file:///etc/bwmon/README
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/etc/bwmon

EnvironmentFile=-/etc/bwmon/.env

ExecStart=/usr/local/bin/bwmon \
  -config /etc/bwmon/config.yaml \
  -env /etc/bwmon/.env

Restart=on-failure
RestartSec=5

AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true

LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
