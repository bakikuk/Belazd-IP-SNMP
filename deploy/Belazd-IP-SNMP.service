# Same as guides/Belazd-IP-SNMP.service — see guides/systemd-daemon.md
[Unit]
Description=Belazd-IP-SNMP per-IP bandwidth SNMP agent
Documentation=file:///etc/Belazd-IP-SNMP/README
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/etc/Belazd-IP-SNMP

EnvironmentFile=-/etc/Belazd-IP-SNMP/.env

ExecStart=/usr/local/bin/Belazd-IP-SNMP \
  -config /etc/Belazd-IP-SNMP/config.yaml \
  -env /etc/Belazd-IP-SNMP/.env

Restart=on-failure
RestartSec=5

AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true

LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
