[Unit]
Description=BWMON per-IP bandwidth SNMP agent
Documentation=file:///etc/bwmon/README
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/etc/bwmon

# Web login credentials (optional). Leading "-" = file may be missing.
EnvironmentFile=-/etc/bwmon/.env

ExecStart=/usr/local/bin/Belazd-IP-SNMP \
  -config /etc/bwmon/config.yaml \
  -env /etc/bwmon/.env

Restart=on-failure
RestartSec=5

# Packet capture + binding SNMP to UDP/161 without running as root long-term.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true

# Lab only — remove for production:
# ExecStart=/usr/local/bin/Belazd-IP-SNMP -config /etc/bwmon/config.yaml -env /etc/bwmon/.env -simulate

LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
