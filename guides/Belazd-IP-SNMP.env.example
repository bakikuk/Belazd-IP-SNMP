# Install: sudo install -m 600 guides/Belazd-IP-SNMP.env.example /etc/Belazd-IP-SNMP/.env
# Web UI login only. SNMP / HTTP allowed / queues → config.yaml or Settings UI.

BELAZD_HTTP_USER=admin
BELAZD_HTTP_PASSWORD=changeMeNow

# Web UI port (optional; BELAZD_HTTP_LISTEN wins if both set)
# BELAZD_HTTP_PORT=8080
