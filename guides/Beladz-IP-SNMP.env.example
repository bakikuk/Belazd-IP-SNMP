# Install: sudo install -m 600 guides/Beladz-IP-SNMP.env.example /etc/Beladz-IP-SNMP/.env
# Web UI login only. SNMP / HTTP allowed / queues → config.yaml or Settings UI.

BELADZ_HTTP_USER=admin
BELADZ_HTTP_PASSWORD=changeMeNow

# Web UI port (optional; BELADZ_HTTP_LISTEN wins if both set)
# BELADZ_HTTP_PORT=8080
